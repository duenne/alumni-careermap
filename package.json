{
  "name": "alumni-careermap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "analytics": "node --import tsx scripts/analytics.ts",
    "analytics:compare": "node --import tsx scripts/analytics-comparison.ts",
    "test:e2e:analytics": "playwright test --config playwright.analytics.config.ts",
    "test:e2e:analytics:local": "playwright test --config playwright.analytics-local.config.ts",
    "dev": "next dev",
    "dev:import": "CAREERMAP_DEV_IMPORT=1 next dev --hostname localhost --port 3100",
    "dev:mapping": "node scripts/dev-mapping.mjs",
    "dev:surveys": "node --env-file-if-exists=.env.local scripts/dev-mapping.mjs --surveys",
    "test:e2e:surveys": "playwright test --config playwright.surveys.config.ts",
    "db:workflow": "node --experimental-strip-types scripts/dev-workflow.mjs --setup-only",
    "dev:workflow": "node --experimental-strip-types scripts/dev-workflow.mjs",
    "test:mapping:corpus": "CAREERMAP_PHASE_D_FIXTURES=1 vitest run src/lib/career-import/local-corpus.test.ts",
    "test:e2e:mapping": "playwright test --config playwright.mapping.config.ts",
    "test:e2e:workflow": "playwright test --config playwright.workflow.config.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test && npm run test:e2e:import && npm run test:e2e:oauth && npm run test:e2e:mapping && npm run test:e2e:workflow && npm run test:e2e:analytics && npm run test:e2e:surveys && npm run test:e2e:integrated",
    "test:e2e:import": "playwright test --config playwright.import.config.ts",
    "test:e2e:oauth": "playwright test --config playwright.oauth.config.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "dev:integrated": "node --env-file-if-exists=.env.local scripts/dev-mapping.mjs --end-to-end",
    "test:e2e:integrated": "playwright test --config playwright.integrated.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "d3-sankey": "0.12.3",
    "next": "^16.0.0",
    "pg": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "overrides": {
    "prisma": {
      "mysql2": "3.24.5"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/d3-sankey": "0.12.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.0.0",
    "jsdom": "26.1.0",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
