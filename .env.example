# Copy to .env and set a fresh, local password. Never commit .env.
POSTGRES_PASSWORD=
# Compose uses host db. URL-encode the password in DATABASE_URL.
DATABASE_URL=postgresql://careermap:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/careermap
# For local Next.js development, use localhost and expose the DB port locally.
# Opt-in for /dev/import. Requires next dev bound to loopback; disabled in production.
# CAREERMAP_DEV_IMPORT=1
# Optional live Third-Party OAuth. Set values only in your private .env.local.
# Never paste credentials into chat or commit them. No access token is configured.
# LINKEDIN_PORTABILITY_MODE=third_party
# LINKEDIN_PORTABILITY_SCOPE=r_dma_portability_3rd_party
# LINKEDIN_REDIRECT_URI=http://localhost:3100/auth/linkedin/portability/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Unified local workflow: npm run db:workflow, then npm run dev:workflow.
# The setup writes a generated POSTGRES_PASSWORD and matching loopback URLs only
# to ignored .env.local. compose.workflow.yaml keeps test data in its own volume.
# CAREERMAP_WORKFLOW_DB_PORT=5433
# Optional operator catalog names, set before the first workflow setup:
# CAREERMAP_WORKFLOW_INSTITUTION=Synthetic Mapping Institute
# CAREERMAP_WORKFLOW_PROGRAM=Synthetic Teststudium
# V3a isolated local survey demo: npm run dev:surveys (Node 22, Docker).
# Put a private password of at least 32 characters in ignored .env.local.
# Browser HTTP Basic username: operator. Do not reuse a real account password.
# CAREERMAP_SURVEY_ADMIN_TOKEN=
# The demo runner supplies the synthetic operator and temporary database.
# For an existing synthetic workflow database, explicitly configure:
# CAREERMAP_DEV_SURVEYS=1
# CAREERMAP_SURVEY_OPERATOR_KIND=INSTITUTION
# Or FACULTY with an exact, nonblank faculty name:
# CAREERMAP_SURVEY_OPERATOR_FACULTY=Synthetic Faculty

# Integrated V3: npm run dev:integrated (fresh synthetic database).
# Uses the configured fixed HTTP loopback callback origin, otherwise localhost:3100.
# Admin password uses CAREERMAP_SURVEY_ADMIN_TOKEN as above. The runner supplies
# CAREERMAP_DEV_DONATION=1, CAREERMAP_SYNTHETIC_DONATION=1 and the exact synthetic
# CAREERMAP_MSI_PROGRAM_ID. Never infer that pilot ID from program names.
# Live OAuth requires the approved third-party product and an exactly matching
# local origin/registered callback. Optional local --port and --host arguments
# let the isolated runner match an existing approved redirect configuration.
# Integrated browser tests use a separate port (3112) and build directory;
# they do not restart or reset a running manual acceptance instance.
